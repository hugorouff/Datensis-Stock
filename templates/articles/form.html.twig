{% extends 'layout.html.twig' %}
{% import '_macros.html.twig' as ui %}

{% set title = article ? 'Modifier l\'article ' ~ article.code : 'Nouvel article' %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        {{ ui.page_header(title, 'Article du catalogue de ' ~ current_client_name() ~ ', enregistré dans Datensis.') }}
        <a href="{{ path('app_articles') }}" class="small fw-semibold text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i>Retour</a>
    </div>

    <div class="card-canva">
        <div class="card-canva-body" style="max-width: 52rem;">
            {{ form_start(form) }}
                {{ form_errors(form) }}
                <div class="row g-3">
                    <div class="col-md-4">{{ form_row(form.code_article) }}</div>
                    <div class="col-md-8">{{ form_row(form.libelle) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-md-4">{{ form_row(form.categorie_id) }}</div>
                    <div class="col-md-4">{{ form_row(form.type_article) }}</div>
                    <div class="col-md-4">{{ form_row(form.unite) }}</div>
                    <div class="col-md-4">{{ form_row(form.prix_ht) }}</div>
                    <div class="col-md-4">{{ form_row(form.prix_achat) }}</div>
                    <div class="col-md-4">{{ form_row(form.taux_tva) }}</div>
                </div>

                <div class="border rounded-3 p-3 mt-3 bg-light">
                    {{ form_row(form.suivi_stock) }}
                    <div class="row g-3">
                        <div class="col-md-4">
                            {{ form_row(form.stock_actuel) }}
                            <div class="form-text">Quantité disponible enregistrée dans Datensis.</div>
                        </div>
                        <div class="col-md-4">{{ form_row(form.stock_minimum) }}</div>
                        <div class="col-md-4">{{ form_row(form.stock_critique) }}</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a href="{{ path('app_articles') }}" class="btn-canva btn-canva-ghost">Annuler</a>
                    <button type="submit" class="btn-canva btn-canva-primary">Enregistrer</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
