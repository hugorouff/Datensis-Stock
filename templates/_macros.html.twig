{% macro euro(amount) -%}
    {{ amount|number_format(2, ',', ' ') }} €
{%- endmacro %}

{% macro stock_badge(article) -%}
    {% if article.stock_level %}
        <span class="badge rounded-pill {{ article.stock_level.badgeClass }}">
            {{ article.stock_level.label }} : {{ article.stock_actuel|number_format(article.stock_actuel == article.stock_actuel|round ? 0 : 2, ',', ' ') }}
        </span>
    {% else %}
        <span class="badge rounded-pill text-bg-light border">{{ article.type_label }}</span>
    {% endif %}
{%- endmacro %}

{% macro status_badge(status) -%}
    <span class="badge rounded-pill {{ status.badgeClass }}">{{ status.label }}</span>
{%- endmacro %}

{% macro page_header(title, subtitle) -%}
    <div>
        <h1 class="page-title h3 text-gradient">{{ title }}</h1>
        {% if subtitle %}<p class="page-lead">{{ subtitle }}</p>{% endif %}
    </div>
{%- endmacro %}

{% macro unavailable(module) -%}
    <div class="alert alert-warning d-flex gap-3" role="alert">
        <i class="bi bi-database fs-5"></i>
        <div>
            <p class="fw-semibold mb-1">Module {{ module }} absent de la base Datensis connectée.</p>
            <p class="small mb-0">Les tables correspondantes n'existent pas dans cette base. Pointez <code>DATENSIS_DATABASE_URL</code> vers la base de production pour afficher ces données.</p>
        </div>
    </div>
{%- endmacro %}
